@model List<OnLineShop2026.Models.User>

<h1>Пользователи</h1>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Имя</th>
            <th>Фамилия</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var user in Model)
        {
            <tr onclick="location.href='@Url.Action("Details", "User", new { id = user.Id })'"
                style="cursor:pointer">

                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>

            </tr>
        }

    </tbody>

</table>